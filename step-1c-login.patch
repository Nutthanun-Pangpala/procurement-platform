@@ -0,0 +1,86 @@
+import { Test } from '@nestjs/testing';
+import { INestApplication } from '@nestjs/common';
+import bcrypt from 'bcryptjs';
+import request from 'supertest';
+import { App } from 'supertest/types';
+import { AppModule } from './../src/app.module.js';
+import { configureApp } from './../src/app.setup.js';
+import { PrismaService } from './../src/prisma/prisma.service.js';
+
+const PASSWORD = 'Correct-Horse-1';
+const user = {
+  id: 'u1',
+  email: 'admin@example.com',
+  fullName: 'Admin',
+  passwordHash: bcrypt.hashSync(PASSWORD, 4),
+  status: 'ACTIVE',
+  roles: [{ role: { code: 'ADMIN' } }],
+  vendorLinks: [],
+};
+
+describe('Auth (e2e)', () => {
+  let app: INestApplication<App>;
+
+  beforeAll(async () => {
+    process.env.JWT_SECRET = 'e2e-secret-e2e-secret-e2e-secret-1234';
+    const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
+      .overrideProvider(PrismaService)
+      .useValue({
+        $connect: async () => undefined,
+        $disconnect: async () => undefined,
+        user: {
+          findFirst: async () => user,
+          findUnique: async () => user,
+          update: async () => user,
+        },
+      })
+      .compile();
+    app = moduleRef.createNestApplication();
+    configureApp(app);
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('POST /auth/login returns a token, then GET /auth/me works with it', async () => {
+    const login = await request(app.getHttpServer())
+      .post('/api/v1/auth/login')
+      .send({ email: user.email, password: PASSWORD })
+      .expect(200);
+
+    const me = await request(app.getHttpServer())
+      .get('/api/v1/auth/me')
+      .set('Authorization', `Bearer ${login.body.accessToken}`)
+      .expect(200);
+    expect(me.body).toMatchObject({ email: user.email, roles: ['ADMIN'] });
+    expect(me.body.passwordHash).toBeUndefined();
+  });
+
+  it('GET /auth/me without a token is 401', () =>
+    request(app.getHttpServer()).get('/api/v1/auth/me').expect(401));
+
+  it('GET /auth/me with a bad token is 401', () =>
+    request(app.getHttpServer())
+      .get('/api/v1/auth/me')
+      .set('Authorization', 'Bearer not.a.token')
+      .expect(401));
+
+  it('POST /auth/login with the wrong password is 401', () =>
+    request(app.getHttpServer())
+      .post('/api/v1/auth/login')
+      .send({ email: user.email, password: 'wrong' })
+      .expect(401));
+
+  it('POST /auth/login rejects unknown fields and bad email (400)', async () => {
+    await request(app.getHttpServer())
+      .post('/api/v1/auth/login')
+      .send({ email: 'not-an-email', password: 'x' })
+      .expect(400);
+    await request(app.getHttpServer())
+      .post('/api/v1/auth/login')
+      .send({ email: user.email, password: PASSWORD, role: 'ADMIN' })
+      .expect(400);
+  });
+});
